<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bakery París</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    @* Work Sans for text; Libre Baskerville Bold + DM Serif Display Italic for the logo lettering *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;700&family=Libre+Baskerville:wght@700&family=DM+Serif+Display:ital@1&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/eShopEnhanced.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark shop-header mb-4">
            <div class="container">
                <a class="navbar-brand shop-logo" asp-area="" asp-controller="Home" asp-action="Index">
                    <partial name="_Logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <vc:category-menu />

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <vc:shopping-cart-summary />
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @* "Added to cart" confirmation, set by ShoppingCartController via TempData (shown once) *@
    @if (TempData["CartMessage"] is string cartMessage)
    {
        <div class="toast-container position-fixed top-0 end-0 p-3 cart-toast-container">
            <div class="toast cart-toast" role="status" aria-live="polite" aria-atomic="true" data-bs-delay="4000">
                <div class="d-flex align-items-center">
                    <div class="toast-body">
                        <span class="cart-toast-check" aria-hidden="true">&#10003;</span>
                        @cartMessage
                        <a asp-controller="ShoppingCart" asp-action="Index" class="cart-toast-link"
                           data-bs-toggle="offcanvas" data-bs-target="#miniCart" aria-controls="miniCart">View cart &rarr;</a>
                    </div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    @* Slide-out cart panel. Opened by the Cart link in the navbar; its contents are fetched
       from /ShoppingCart/MiniCart when it opens (see site.js). *@
    <div class="offcanvas offcanvas-end mini-cart" tabindex="-1" id="miniCart" aria-labelledby="miniCartLabel">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title" id="miniCartLabel">Your cart</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body" id="miniCartBody" data-url="@Url.Action("MiniCart", "ShoppingCart")">
            <p class="mini-cart-loading">Loading your cart&hellip;</p>
        </div>
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer shop-footer">
        <div class="container d-flex align-items-center gap-3">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="footer-logo">
                <partial name="_Logo" />
            </a>
            <span>&copy; 2026 Bakery París &middot; <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
