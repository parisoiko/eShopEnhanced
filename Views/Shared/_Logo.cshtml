@* The Bakery París logo: wheat roundel + "BAKERY" + "París", as inline SVG.

   It's inline (not an <img src="logo.svg">) because an SVG loaded as an image
   can't use the page's web fonts, so the lettering would fall back to a plain font.

   Colours come from CSS, so the same logo works on any background:
     color          -> roundel, wheat and "BAKERY"   (via currentColor)
     --logo-accent  -> "París" and the two thin lines
   See ".brand-logo" in site.css. *@

<svg class="brand-logo" viewBox="0 0 380 120" role="img" aria-label="Bakery París">
    @* Roundel: outer ring always, inner ring only where the logo is shown large *@
    <circle cx="50" cy="60" r="44" fill="none" stroke="currentColor" stroke-width="2.5" />
    <circle class="logo-inner-ring" cx="50" cy="60" r="38" fill="none" stroke="currentColor" stroke-width="0.75" />

    @* Wheat ear: a stalk with three pairs of grains and one on top *@
    <g fill="currentColor" stroke="currentColor" transform="translate(50,90) scale(0.95)">
        <line x1="0" y1="0" x2="0" y2="-56" stroke-width="3" />
        <ellipse cx="-4.5" cy="-16" rx="3.6" ry="7.5" transform="rotate(-28 -4.5 -16)" />
        <ellipse cx="4.5" cy="-16" rx="3.6" ry="7.5" transform="rotate(28 4.5 -16)" />
        <ellipse cx="-4.5" cy="-27" rx="3.6" ry="7.5" transform="rotate(-28 -4.5 -27)" />
        <ellipse cx="4.5" cy="-27" rx="3.6" ry="7.5" transform="rotate(28 4.5 -27)" />
        <ellipse cx="-4.5" cy="-38" rx="3.6" ry="7.5" transform="rotate(-28 -4.5 -38)" />
        <ellipse cx="4.5" cy="-38" rx="3.6" ry="7.5" transform="rotate(28 4.5 -38)" />
        <ellipse cx="0" cy="-52" rx="3.6" ry="8" />
    </g>

    @* Lettering *@
    <text x="116" y="60" textLength="196" lengthAdjust="spacing" class="logo-bakery" fill="currentColor">BAKERY</text>
    <line class="logo-accent-line" x1="118" y1="86" x2="172" y2="86" stroke-width="1.5" />
    <text class="logo-paris" x="214" y="96" text-anchor="middle">París</text>
    <line class="logo-accent-line" x1="256" y1="86" x2="310" y2="86" stroke-width="1.5" />
</svg>
