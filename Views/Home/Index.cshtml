@model HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

@* Hero banner: the large "primary" version of the logo, white on terracotta *@
<section class="brand-hero mb-5">
    <h1 class="visually-hidden">Bakery París</h1>
    <partial name="_Logo" />
    <p class="brand-hero-tagline">Choose a category to see what's fresh today.</p>
</section>

@* ===== Picks of the week ===== *@
@if (Model.PicksOfTheWeek.Any())
{
    <section class="week-section mb-5">
        <h2 class="section-title">&#9733; Picks of the week</h2>

        <div class="row g-4">
            @foreach (var product in Model.PicksOfTheWeek)
            {
                <div class="col-sm-6 col-lg-3">
                    <partial name="_ProductCard" model="product" />
                </div>
            }
        </div>
    </section>
}

@* ===== Categories ===== *@
<h2 class="section-title">Shop by category</h2>

<div class="row g-4">
    @foreach (var category in Model.Categories)
    {
        <div class="col-sm-6 col-lg-4">
            @* The whole card is one link to that category's product list *@
            <a asp-controller="Product" asp-action="List" asp-route-category="@Slug.From(category.CategoryName)"
               class="category-card-link">
                <div class="card product-card h-100">
                    <img src="@category.ImageUrl" alt="@category.CategoryName" class="card-img-top product-card-img" />
                    <div class="card-body">
                        <h2 class="product-card-name">@category.CategoryName</h2>
                        <p class="category-card-description">@category.Description</p>
                        @if (category.SubCategories != null && category.SubCategories.Any())
                        {
                            <p class="category-card-subcategories">
                                @string.Join(" · ", category.SubCategories.Select(s => s.SubCategoryName))
                            </p>
                        }
                    </div>
                </div>
            </a>
        </div>
    }
</div>
