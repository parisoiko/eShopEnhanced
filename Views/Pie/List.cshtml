@using System.Globalization
@model PieListViewModel

@{
    ViewData["Title"] = Model.CurrentCategory;
    var euro = CultureInfo.GetCultureInfo("el-GR");
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-shop">&larr; All categories</a>
    <h1 class="page-title m-0">@Model.CurrentCategory</h1>
</div>

<div class="row g-4">
    @foreach (var pie in Model.Pies)
    {
        <div class="col-sm-6 col-lg-4">
            <div class="card pie-card h-100">
                <img src="@pie.ImageUrl" alt="@pie.Name" class="card-img-top pie-card-img" />
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-baseline">
                        <h2 class="pie-card-name">@pie.Name</h2>
                        <span class="pie-card-price">@pie.Price.ToString("c", euro)</span>
                    </div>
                    <p class="pie-card-subcategory">@pie.SubCategory.SubCategoryName</p>
                </div>
            </div>
        </div>
    }
</div>
