{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "eShopEnhanced (web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/eShopEnhanced/bin/Debug/net10.0/eShopEnhanced.dll",
      "args": [],
      "cwd": "${workspaceFolder}/eShopEnhanced",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5131"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/eShopEnhanced/Views"
      }
    }
  ]
}
