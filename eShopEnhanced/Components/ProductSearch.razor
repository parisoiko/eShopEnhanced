@*
    Live product search: a Blazor component.
    It runs on the SERVER. blazor.server.js in the browser keeps a live connection (SignalR) open;
    every keystroke is sent to the server, OnInput runs here in C#, and Blazor sends back only the
    parts of the HTML that changed. No page reload, and no JavaScript written by us.

    Used in Views/Product/Search.cshtml with:
      <component type="typeof(eShopEnhanced.Components.ProductSearch)" render-mode="ServerPrerendered" />
*@

@inject IServiceScopeFactory ScopeFactory

<div class="product-search">
    <input class="form-control form-control-lg product-search-input"
           type="search"
           placeholder="Search for croissants, cheese cake, sourdough..."
           aria-label="Search products"
           autofocus
           value="@searchText"
           @oninput="OnInput" />

    @if (searchText.Trim().Length < 2)
    {
        <p class="product-search-hint">Type at least 2 letters to search.</p>
    }
    else if (results.Count == 0)
    {
        <p class="product-search-hint">No products found for "@searchText.Trim()".</p>
    }
    else
    {
        <p class="product-search-hint">@results.Count @(results.Count == 1 ? "product" : "products") found</p>

        <div class="row g-4">
            @foreach (Product product in results)
            {
                @* The same look as _ProductCard. Blazor components can't use MVC partials or
                   tag helpers like asp-route-id, so the details link is written out by hand. *@
                string detailsUrl = $"/products/{product.ProductId}/{Slug.From(product.Name)}";

                <div class="col-sm-6 col-lg-4">
                    <div class="card product-card h-100">
                        <a href="@detailsUrl">
                            <img src="@product.ImageUrl" alt="@product.Name" class="card-img-top product-card-img" />
                        </a>
                        <div class="card-body">
                            <h3 class="product-card-name">
                                <a href="@detailsUrl" class="product-card-title-link">@product.Name</a>
                            </h3>
                            <div class="d-flex justify-content-between align-items-baseline mt-1">
                                <span class="product-card-subcategory m-0">@product.SubCategory.SubCategoryName</span>
                                <span class="product-card-price">@product.Price.ToString("c")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    // Filled from the page: /products/search?q=cake -> InitialQuery = "cake"
    [Parameter]
    public string InitialQuery { get; set; } = string.Empty;

    private string searchText = string.Empty;
    private List<Product> results = new();

    // Counts searches, so a slow, OLD search can never overwrite the results of a newer one
    private int latestSearch;

    // Runs when the component starts: search straight away if the page was opened with a query
    protected override async Task OnInitializedAsync()
    {
        await SearchAsync(InitialQuery);
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        await SearchAsync(e.Value?.ToString() ?? string.Empty);
    }

    private async Task SearchAsync(string text)
    {
        searchText = text;
        int thisSearch = ++latestSearch;

        if (searchText.Trim().Length < 2)
        {
            results = new();
            return;
        }

        // A fresh scope (and so a fresh DbContext) per search. In Blazor Server one component lives as
        // long as the browser tab, and fast typing starts overlapping searches; a single shared
        // DbContext would fail with "a second operation was started on this context".
        using IServiceScope scope = ScopeFactory.CreateScope();
        var productRepository = scope.ServiceProvider.GetRequiredService<IProductRepository>();
        List<Product> found = await productRepository.SearchProductsAsync(searchText);

        if (thisSearch == latestSearch)
        {
            results = found;
        }
    }
}
