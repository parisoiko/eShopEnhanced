@model Product

@* One product card, used on the home page (picks of the week) and on the product lists.
   Use it with: <partial name="_ProductCard" model="product" />
   The surrounding column (<div class="col-...">) is left to the page, so each page decides how wide the cards are.
   The photo and the name link to the details page; the button below adds the product to the cart
   (a button can't sit inside a link, so the card itself is no longer one big link). *@

<div class="card product-card h-100">
    <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId" asp-route-slug="@Slug.From(Model.Name)">
        <img src="@Model.ImageUrl" alt="@Model.Name" class="card-img-top product-card-img" />
    </a>
    <div class="card-body d-flex flex-column">
        <h3 class="product-card-name">
            <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId" asp-route-slug="@Slug.From(Model.Name)"
               class="product-card-title-link">@Model.Name</a>
        </h3>
        <div class="d-flex justify-content-between align-items-baseline mt-1 mb-3">
            <span class="product-card-subcategory m-0">@Model.SubCategory.SubCategoryName</span>
            <span class="product-card-price">@Model.Price.ToString("c")</span>
        </div>
        @* mt-auto pushes the button to the bottom, so buttons line up across cards of different heights *@
        <div class="mt-auto">
            <partial name="_AddToCartButton" model="Model" />
        </div>
    </div>
</div>
