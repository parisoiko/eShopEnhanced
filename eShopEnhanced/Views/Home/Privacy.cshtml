@{
    ViewData["Title"] = "Privacy";
}

<div class="card product-card checkout-card p-4 p-md-5">
    <h1 class="page-title mb-4">Privacy</h1>

    <p class="lead">Bakery París is a demo shop built as a learning project. No real orders are delivered and no payments are taken.</p>

    <h2 class="checkout-section-title mt-4">What we store</h2>
    <ul>
        <li><strong>Your shopping cart</strong>: the products and amounts, linked to a random cart id kept in a session cookie.</li>
        <li><strong>Your account</strong> (if you register): your name, email address, phone number and delivery address. Passwords are stored only as a secure hash.</li>
        <li><strong>Your orders</strong>: the details you enter at checkout and the products ordered.</li>
    </ul>

    <h2 class="checkout-section-title mt-4">Cookies</h2>
    <ul>
        <li>A <strong>session cookie</strong> that remembers your cart while you browse.</li>
        <li>A <strong>login cookie</strong> when you are logged in.</li>
        <li>An <strong>anti-forgery cookie</strong> that protects the site's forms.</li>
    </ul>
    <p class="mb-0">There are no tracking, advertising or analytics cookies.</p>
</div>
