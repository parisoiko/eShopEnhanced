@{
    ViewData["Title"] = "Search";
}

@section Head {
    @* Blazor resolves /_blazor against the base address; without this it would try /products/_blazor. *@
    <base href="~/" />
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-shop">&larr; All categories</a>
    <h1 class="page-title m-0">Search</h1>
</div>

@* Prerendered for a fast first paint; InitialQuery is the text typed in the navbar search box *@
<component type="typeof(eShopEnhanced.Components.ProductSearch)" render-mode="ServerPrerendered"
           param-InitialQuery="@((string)ViewBag.SearchQuery)" />

@section Scripts {
    @* Only this page uses Blazor, so the script is loaded here rather than in _Layout *@
    <script src="~/_framework/blazor.server.js"></script>
}
