@{
    ViewData["Title"] = "Search";
}

@section Head {
    @* Blazor works out its connection address (/_blazor) relative to the page's base address.
       This page lives at /products/search, so without <base href="/"> it would try /products/_blazor. *@
    <base href="~/" />
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-shop">&larr; All categories</a>
    <h1 class="page-title m-0">Search</h1>
</div>

@* The Blazor component. render-mode="ServerPrerendered": the server first sends normal HTML
   (fast first view, works for search engines), then blazor.server.js connects and makes it live. *@
@* param-InitialQuery sets the component's [Parameter] InitialQuery: what was typed in the navbar *@
<component type="typeof(eShopEnhanced.Components.ProductSearch)" render-mode="ServerPrerendered"
           param-InitialQuery="@((string)ViewBag.SearchQuery)" />

@section Scripts {
    @* Only this page needs Blazor's live connection, so the script is loaded here, not in _Layout.
       "~/" = from the root of the site. Without it the browser would look in /products/_framework/,
       because this page lives at /products/search. *@
    <script src="~/_framework/blazor.server.js"></script>
}
