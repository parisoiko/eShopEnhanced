@model List<Product>

@* The dropdown under the navbar search box. Returned by ProductController.SearchSuggestions
   and inserted by site.js while the visitor types. *@

@{
    string query = ViewBag.SearchQuery;
    int totalFound = ViewBag.TotalFound;
}

@if (!Model.Any())
{
    <div class="search-suggestions-empty">No products found for "@query".</div>
}
else
{
    <ul class="search-suggestions-list">
        @foreach (Product product in Model)
        {
            @* Link (photo, name, price -> details page) and quick-add button side by side:
               a button can't sit inside a link, so they're two separate elements *@
            <li class="search-suggestion-row">
                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId"
                   asp-route-slug="@Slug.From(product.Name)" class="search-suggestion">
                    <img src="@product.ImageUrl" alt="" class="search-suggestion-thumb" />
                    <span class="search-suggestion-text">
                        <span class="search-suggestion-name">@product.Name</span>
                        <span class="search-suggestion-sub">@product.SubCategory.SubCategoryName</span>
                    </span>
                    <span class="search-suggestion-price">@product.Price.ToString("c")</span>
                </a>

                @* Quick add, turning into a small − 2 + counter once the product is in the cart *@
                <div class="search-quick-add">
                    <partial name="_QuickAddControl" model="product" />
                </div>
            </li>
        }
    </ul>
    <a asp-controller="Product" asp-action="Search" asp-route-q="@query" class="search-suggestions-all">
        See all @totalFound @(totalFound == 1 ? "result" : "results") for "@query" &rarr;
    </a>
}
