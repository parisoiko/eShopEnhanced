@model ProductListViewModel

@{
    ViewData["Title"] = Model.CurrentCategory;
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-shop">&larr; All categories</a>
    <h1 class="page-title m-0">@Model.CurrentCategory</h1>
</div>

<div class="row g-4">
    @foreach (var product in Model.Products)
    {
        <div class="col-sm-6 col-lg-4">
            <partial name="_ProductCard" model="product" />
        </div>
    }
</div>
