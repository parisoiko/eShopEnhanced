@*
    Overrides the Identity UI layout: the built-in pages use /Areas/Identity/Pages/_Layout.cshtml, and a
    file at this path in the app takes priority over the package's. It delegates to the shop layout.
*@
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="identity-page">
    @RenderBody()
</div>

@* Pass the Identity pages' scripts (form validation) through to the shop layout *@
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
